    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python As Module",
            "type": "python",
            "request": "launch",
            "module": "${command:extension.commandvariable.file.relativeFileDotsNoExtension}",
            "console": "integratedTerminal",
            "cwd":"${workspaceFolder}",
            "justMyCode": true,
            "args": [
                "--config_path", "noodlepy/config/config.yml",
                "--output_path", "noodlepy/data/simulated_patients/",
                "--n_spectra", "10"
            ],

        }
    ]
}